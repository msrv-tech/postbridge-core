APP_ENV=dev
# Runtime mode for the shared frontend and browser-safe app API.
# selfhost: Core serves a local/self-host product surface.
# saas: Core is used behind a private SaaS BFF.
POSTBRIDGE_APP_MODE=selfhost
# Stable local tenant id used by the self-host browser-safe app API.
POSTBRIDGE_SELFHOST_TENANT_ID=00000000-0000-4000-8000-000000000001
# Core-wide locale for user-facing product text in self-hosted Core.
# POSTBRIDGE_DEFAULT_LOCALE=en
# IANA timezone for server defaults in self-hosted Core.
# POSTBRIDGE_DEFAULT_TIMEZONE=UTC
# Required for Docker Compose Postgres. Replace before running anything beyond a throwaway local stack.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg2://postbridge:replace-with-a-long-random-password@postgres:5432/postbridge
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0

# Fernet key for encrypting JSON in channel_credentials.encrypted_secret. Required.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional API and worker error reporting.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Telegram credentials (required to read channel history)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=postbridge
# TELEGRAM_SESSION_STRING=  # self-host: generate a Telethon StringSession locally

# Telegram proxy. For Docker deployments, see docs/telegram-proxy.md.
TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
# TELEGRAM_PROXY_FALLBACK_DIRECT=true  # optional one-time direct retry after transport/proxy errors

# MAX API (platform-api.max.ru, required to publish posts)
# target_channel: chat_id or username.
MAX_API_BASE_URL=
MAX_API_TOKEN=
MAX_API_TIMEOUT_SECONDS=30

# VK credentials.
# VK_ACCESS_TOKEN is usually a community token for wall.post.
# VK_USER_ACCESS_TOKEN is optional and is used by wall.get when a community token is not enough.
VK_ACCESS_TOKEN=
VK_USER_ACCESS_TOKEN=

# LinkedIn publisher fallback for self-host deployments.
# Person publishing requires w_member_social; organization publishing requires w_organization_social.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202601

# Batch import retry and stuck-run recovery.
# BATCH_IMPORT_RUN_MAX_RETRIES=2
# BATCH_IMPORT_RUN_RETRY_DELAY_SECONDS=10
# BATCH_IMPORT_RUN_RETRY_BACKOFF_MULTIPLIER=2.0
# BATCH_IMPORT_RUN_RETRY_MAX_DELAY_SECONDS=300
# BATCH_IMPORT_RUN_STUCK_TIMEOUT_SECONDS=900

# Optional status event webhook. Without a URL, outbox events stay internal.
# STATUS_EVENT_WEBHOOK_URL=https://your-hosted-backend.example.com/internal/core/events/status
# STATUS_EVENT_WEBHOOK_TOKEN=
# STATUS_EVENT_WEBHOOK_TIMEOUT_SECONDS=5

# Trusted backend to Core internal Service API: Bearer + X-Tenant-Id.
# CORE_SERVICE_TOKEN=

# Live-sync / internal publish (legacy): X-Sync-Publish-Token
# SYNC_PUBLISH_TOKEN=

# Telegram bot runtime.
# SAAS_BASE_URL is a compatibility name for a hosted backend base URL.
# SAAS_BASE_URL=http://backend:8001
# BOT_SECRET=
# TELEGRAM_BOT_TOKEN=
# CORE_BASE_URL=http://127.0.0.1:8000
# BOT_MODE=long_polling
# BOT_WEBHOOK_BASE_URL=https://core.example.com
# BOT_WEBHOOK_PATH=/internal/bot/webhook
# BOT_WEBHOOK_SECRET=
# WEB_APP_BASE_URL=https://app.example.com
# MAGIC_LINK_BASE_URL=
# TELEGRAM_BOT_USERNAME=postbridge_bot

# AI Gateway: OpenAI-compatible POST /v1/chat/completions. See docs/ai-gateway.md.
# AI_GATEWAY_ENABLED=0
# AI_GATEWAY_BASE_URL=https://api.example.com/v1
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_TIMEOUT_SECONDS=60
# Default model when a Core request does not pass model explicitly.
# AI_GATEWAY_DEFAULT_MODEL=gpt-4o-mini
# Default AI response language when target_language is not passed.
# AI_GATEWAY_DEFAULT_RESPONSE_LANGUAGE=en
# Image generation model id; Core does not fall back to the chat model.
# AI_IMAGE_GENERATION_MODEL=gpt-image-2
# AI_IMAGE_GENERATION_SIZE=1536x1024

# Agent runtime (Core). AGENT_LLM_* override AI_GATEWAY_* fallback values.
# AGENT_LLM_BASE_URL=
# AGENT_LLM_API_KEY=
# AGENT_LLM_DEFAULT_MODEL=
# AGENT_LLM_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_LLM_MAX_TOKENS=2048
# AGENT_DEFAULT_RESPONSE_LANGUAGE=en
# AGENT_SEARCH_BACKENDS=searxng,duckduckgo
# AGENT_SEARCH_SEARXNG_BASE_URL=http://searxng:8080
# AGENT_SEARCH_LANGUAGE=ru

# Media storage for /internal/service/media/upload: local or s3.
# MEDIA_STORAGE_TYPE=none
# MEDIA_STORAGE_TYPE=local
# MEDIA_STORAGE_PATH=/var/postbridge/media
# MEDIA_BASE_URL=http://127.0.0.1:8000/media
# MEDIA_STORAGE_TYPE=s3
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=
# Compatibility aliases: MEDIA_S3_ENDPOINT_URL, MEDIA_S3_BUCKET, MEDIA_S3_ACCESS_KEY, MEDIA_S3_SECRET_KEY, MEDIA_S3_REGION, S3_PUBLIC_BASE, MEDIA_S3_PUBLIC_BASE_URL
